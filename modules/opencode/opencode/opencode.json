{
    "$schema": "https://opencode.ai/config.json",
    "agent": {
        "plan": {
            "disable": true,
            "options": {},
            "permission": {}
        },
        "build": {
            "disable": true,
            "options": {},
            "permission": {}
        },
        "general": {
            "disable": true,
            "options": {},
            "permission": {}
        },
        "explore": {
            "disable": true,
            "options": {},
            "permission": {}
        }
    },
    "permission": {
        "question": "allow"
    },
    "mcp": {
        "azure-devops": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@azure-devops/mcp",
                "neocom"
            ],
            "enabled": false
        },
        "postgres-dba": {
            "type": "local",
            "command": [
                "uvx",
                "postgres-mcp",
                "postgresql://postgres:postgres@postgres:5432/<db>"
            ],
            "enabled": false
        }
    }
}
