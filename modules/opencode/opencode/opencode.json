{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "generalist",
    "agents": {
      "plan": { "disabled": true },
      "build": { "disabled": true },
      "general": { "disabled": true },
      "explore": { "disabled": true }
    },
    "mcp": {
        "servers": {
            "azure-devops": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@azure-devops/mcp",
                    "neocom"
                ],
                "disabled": true
            },
            "postgres-dba": {
                "type": "local",
                "command": [
                    "uvx",
                    "postgres-mcp",
                    "postgresql://postgres:postgres@postgres:5432/<db>"
                ],
                "disabled": true
            },
            "wordcraft": {
                "type": "local",
                "command": [
                    "wordcraft-cli",
                    "mcp",
                    "--connect",
                    "127.0.0.1:7981"
                ],
                "disabled": true
            }
        }
    }
}
