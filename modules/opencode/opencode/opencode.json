{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "azure-devops": {
      "type": "local",
      "command": ["npx", "-y", "@azure-devops/mcp", "neocom"],
      "enabled": false
    },
    "postgres-dba": {
      "type": "local",
      "command": [
        "uvx",
        "postgres-mcp",
        "postgresql://postgres:postgres@postgres:5432/<db>"
      ],
      "enabled": false
    }
  }
}
